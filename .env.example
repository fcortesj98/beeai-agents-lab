# Copy to .env and fill in. Not needed inside the IBM Skills Network lab,
# where these values are preset for you. Never commit your real .env.

# --- watsonx.ai (sections 2-3, 5-12) ---
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
# One of these two:
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_REGION=us-south

# --- OpenAI (section 4) ---
OPENAI_API_KEY=

# --- Optional model overrides (format: provider:model) ---
# BEEAI_CHAT_MODEL=watsonx:ibm/granite-4-h-small
# BEEAI_STRUCTURED_MODEL=openai:gpt-5-nano
# BEEAI_AGENT_MODEL=watsonx:meta-llama/llama-4-maverick-17b-128e-instruct-fp8

# --- Debugging: print LiteLLM's raw request/response ---
# BEEAI_DEBUG=1
